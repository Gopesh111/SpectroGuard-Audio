# ==============================================================================
# SpectroGuard-Audio Environment Configuration
# ==============================================================================

# Application & Service
APP_NAME=SpectroGuard-Audio
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Hardware Acceleration (cpu / cuda)
DEVICE=cpu

# Audio DSP Parameters
SAMPLE_RATE=16000
TARGET_DURATION_SEC=3.0
TARGET_RMS_DBFS=-23.0
VAD_TOP_DB=25

# Model Checkpoint Paths
CHECKPOINT_DIR=./checkpoints
DEFAULT_MODEL_TYPE=wav2vec
WAV2VEC_MODEL_NAME=facebook/wav2vec2-base
RESNET_MODEL_PATH=./checkpoints/spectral_resnet_best.pt
WAV2VEC_MODEL_PATH=./checkpoints/wav2vec_detector_best.pt

# Decision Threshold (Calibrated on ASVspoof / In-the-Wild EER)
EER_CALIBRATED_THRESHOLD=0.518
